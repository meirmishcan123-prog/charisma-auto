@echo off
chcp 65001 >nul
title Roblox Tree Macro
cd /d "%~dp0"
echo ==================================================
echo    Roblox Tree Macro  (seek trees ^& chop)
echo ==================================================
echo.
where py >nul 2>nul && (set PY=py) || (set PY=python)
%PY% --version >nul 2>nul
if errorlevel 1 (
  echo [!] Python is NOT installed.
  echo     1^) Open https://www.python.org/downloads/
  echo     2^) Install it, and TICK "Add python.exe to PATH".
  echo     3^) Run this file again.
  echo.
  pause
  exit /b
)
echo Installing needed libraries (first run only, please wait)...
%PY% -m pip install --quiet --upgrade pip
%PY% -m pip install --quiet pynput mss numpy
set "PYF=%TEMP%\roblox_tree_macro.py"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$c=Get-Content -LiteralPath '%~f0'; $i=[array]::IndexOf($c,'::PYB64::')+1; $b=[string]::Join('',$c[$i..($c.Count-1)]); [IO.File]::WriteAllBytes($env:PYF,[Convert]::FromBase64String($b))"
echo.
echo ==================================================
echo  READY!
echo   1. Click on the ROBLOX window (very important!).
echo   2. Press  F6  -- it finds trees and walks to chop.
echo   3. Press  F6  to pause, or  F8  to quit.
echo.
echo  If the character walks the WRONG way, rotate the
echo  camera so the character faces "up" on screen.
echo  Roblox must be focused and NOT run as admin.
echo ==================================================
echo.
%PY% "%PYF%"
echo.
echo Macro closed. You can close this window.
pause
exit /b
